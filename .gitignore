# 依赖
node_modules/

# 编译产物（CI 会重新构建）
dist/
*.tsbuildinfo

# 打包产物
*.tgz
*.tar.gz

# ──────────────────────────────────────────────────────────────
#  安全：下列文件含用户凭据，绝不可提交
#
#  插件的运行时数据实际写在 ~/.dsh/hunyuan-image/（仓库目录之外），
#  但调试时若被拷进仓库就会泄露。这里显式忽略，并配合
#  `scripts/check-no-secrets.mjs`（CI 中强制运行）双重防护。
# ──────────────────────────────────────────────────────────────
hunyuan-image-config.json
hunyuan-image-gallery.json
.credentials.yaml
secrets.json
*.credentials.json

# 通用运行时数据
data/
*.sqlite
*.sqlite-journal
*.db

# 本地配置与环境变量
config.local.json
.env
.env.*
!.env.example

# 系统文件
.DS_Store
Thumbs.db

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo

# 测试覆盖率
coverage/
.nyc_output/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
