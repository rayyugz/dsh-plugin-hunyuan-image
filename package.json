{
  "name": "dsh-plugin-hunyuan-image",
  "version": "1.0.0",
  "description": "DSH 原生插件：集成腾讯混元生图（Hy-Image-3.5-preview / Hy-Image-3.0），带本地图库、上下文感知与多平台可移植性。",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tencent",
    "hunyuan",
    "image-generation",
    "ai-art"
  ],
  "author": "rayyugz",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "腾讯混元生图",
    "description": "腾讯混元 Hy-Image 生图插件：生成、图库、参数配置，图片本地保存。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "esbuild": "0.25.12",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
